# ---------------------------------------------------------------------------
# Alertas do ambiente dev (scripts/alerts, docs/alertas.md). O make alerts-up
# cria o .env.alerts (fora do git) sozinho, lendo o environment dev do GitHub
# pelo gh. Copie este arquivo so para preencher a mao ou mudar algo.
# ---------------------------------------------------------------------------

# Shell do dev na Vercel (o deploy publica em <VERCEL_ALIAS_PREFIX>-dev.vercel.app)
ALERTS_SITE_URL=https://alexcaje-saas-dev.vercel.app

# Projeto Supabase de dev e a chave publishable (a mesma SUPABASE_ANON_KEY do
# environment dev no GitHub; e publica, vai no bundle do front)
ALERTS_SUPABASE_URL=https://xxqbbkphktnxnpdlzwcz.supabase.co
ALERTS_SUPABASE_PUBLISHABLE_KEY=

# Chave secreta (sb_secret_...), so para as metricas do banco. Grave com
# `make alerts-key`, que confere a chave antes. Vazia, os alertas de banco
# (disco, conexoes, CPU, memoria, somente leitura) ficam de fora.
ALERTS_SUPABASE_SECRET_KEY=

# Repositorio e branch do ambiente: o alerta de deploy olha o ultimo run do
# workflow Deploy nela
ALERTS_GITHUB_REPO=AlexCajeFelix/saas-multitenant-microfrontends
ALERTS_GITHUB_BRANCH=develop

# 0 para nao instalar a notificacao no desktop (fica so a caixa do ntfy)
ALERTS_DESKTOP=1
