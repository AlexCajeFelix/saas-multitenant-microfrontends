{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["VITE_API_URL", "VITE_ANON_KEY", "VITE_APP_VERSION", "VITE_SHOW_DEMO_USERS"],
  "globalDependencies": [".env.local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "../../packages/platform/**"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$", "../../packages/platform/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
