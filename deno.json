{
  "lock": false,
  "tasks": {
    "test": "deno test --allow-env --allow-net=127.0.0.1 tests/",
    "check": "deno check supabase/functions/*/index.ts",
    "fmt": "deno fmt supabase/functions tests",
    "lint": "deno lint supabase/functions tests"
  },
  "fmt": {
    "lineWidth": 100,
    "singleQuote": false,
    "exclude": ["supabase/migrations", "supabase/seed"]
  },
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "exclude": ["no-explicit-any"]
    }
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "lib": ["deno.window", "esnext"]
  }
}
