# ---------------------------------------------------------------------------
# Segredos e portas do stack local. Copie para .env e rode `make keys`.
# ---------------------------------------------------------------------------

# Postgres
POSTGRES_PASSWORD=postgres-local-password
POSTGRES_DB=postgres
POSTGRES_PORT=54322

# Gateway HTTP (SUPABASE_URL do lado de fora do Docker)
GATEWAY_PORT=8000
API_EXTERNAL_URL=http://localhost:8000
SITE_URL=http://localhost:3000

# Segredo usado para assinar TODOS os JWT (GoTrue, PostgREST e Edge Functions).
# Precisa ter no minimo 32 caracteres.
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
JWT_EXPIRY=3600

# Geradas por `make keys` a partir do JWT_SECRET. Nao edite a mao.
ANON_KEY=
SERVICE_ROLE_KEY=

# GoTrue
DISABLE_SIGNUP=false
MAILER_AUTOCONFIRM=true

# Nivel de log das Edge Functions: debug | info | warn | error
LOG_LEVEL=info
