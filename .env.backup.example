# ---------------------------------------------------------------------------
# Backup local do banco (scripts/backup). Copie para .env.backup (fora do git)
# e preencha as senhas: as mesmas dos secrets SUPABASE_DB_PASSWORD_DEV/PROD do
# GitHub (ou Dashboard > Project Settings > Database > Reset password).
# ---------------------------------------------------------------------------
SUPABASE_REF_DEV=xxqbbkphktnxnpdlzwcz
SUPABASE_REF_PROD=ogmypegyjguvuzmrmftx
SUPABASE_DB_PASSWORD_DEV=
SUPABASE_DB_PASSWORD_PROD=

# Pooler em modo sessao da regiao dos projetos (sa-east-1)
BACKUP_POOLER_HOST=aws-0-sa-east-1.pooler.supabase.com

# Pasta dos dumps e quantos backups guardar por ambiente (o Pro guarda 7 dias)
BACKUP_DIR=backups
BACKUP_KEEP=7

# Backup automatico (make backup-schedule): ambientes e intervalo minimo
BACKUP_ENVS="prod dev"
BACKUP_INTERVAL_HOURS=24

# Bucket do Storage (make bucket-list/push/pull): a chave secreta de cada
# projeto (Settings > API Keys, sb_secret_...) ou um token pessoal (sbp_...),
# com o qual o script busca a chave. O pipeline usa o token.
# SUPABASE_SECRET_KEY_DEV=
# SUPABASE_SECRET_KEY_PROD=
# SUPABASE_ACCESS_TOKEN=
BACKUP_BUCKET=backups
