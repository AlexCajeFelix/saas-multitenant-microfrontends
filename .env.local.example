# Variaveis do frontend (todas as zonas leem daqui: envDir e a raiz do repo).
# `make web-env` escreve o .env.local a partir do .env do stack local.
# Para apontar para o Supabase na nuvem, use a URL do projeto e a chave anon
# (ou publishable) de Settings > API.
VITE_API_URL=http://localhost:8000
VITE_ANON_KEY=
VITE_SHOW_DEMO_USERS=true
